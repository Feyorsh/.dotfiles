sanitize tridactyllocal tridactylsync

set newtab about:blank

set editorcmd $SHELL -ic "emacsclient %f"

" redirect to old reddit
autocmd DocStart ^http(s?)://www.reddit.com js tri.excmds.urlmodify("-t", "www", "old")
" hint for social media comments
bind ;c hint -Jc [class*="expand"],[class*="togg"],[class="comment_folder"]
" copy git clone command from github repo
bind yg composite js "git clone " + document.location.href.replace(/https?:\/\//,"git@").replace("/",":").replace(/$/,".git") | clipboard yank
" jump to github search
bindurl ^https://github.com gi hint -Vc .AppHeader-searchButton

unbind <C-f>
bind / fillcmdline find
bind ? fillcmdline find -?
bind n findnext 1
bind N findnext -1
set findcase sensitive

set smoothscroll false

bind j scrollline 2
bind J scrollline 10
bind k scrollline -2
bind K scrollline -10
bind h scrollpx -2
" bind H scrollpx -50
bind l scrollpx 2
" bind L scrollline 50
bind --mode=ex <C-j> ex.next_completion
bind --mode=ex <C-k> ex.prev_completion
bind < back
bind > forward

bind H tabprev
bind L tabnext
bind gh tabprev
bind gl tabnext
bind x tabclose

guiset_quiet hoverlink right

blacklistadd ^https://www.nytimes.com/(crosswords|games|puzzles).*
blacklistadd ^https://discord.com
blacklistadd ^https://leetcode.com
blacklistadd ^https://hackerrank.com
blacklistadd ^https://overleaf.com
