diff --git a/dgamelaunch.c b/dgamelaunch.c
index cbc2c46..84c1915 100644
--- a/dgamelaunch.c
+++ b/dgamelaunch.c
@@ -1192,6 +1192,10 @@ game_get_column_data(struct dg_game *game,
             snprintf(data, bufsz, "  N/A");
             *hilite = CLR_GREEN;
             break;
+        } else if (game->extra_info && !strcmp(game->extra_info, "lisp")) {
+            snprintf(data, bufsz, "  lisp");
+            *hilite = CLR_MAGENTA;
+            break;
         }
         snprintf(data, bufsz, "%3dx%3d", game->ws_col, game->ws_row);
 	if (showplayers)
@@ -1528,7 +1532,7 @@ watchgame:
 		  setproctitle("%s [watching %s]", me->username, chosen_name);
 	      else
 		  setproctitle("<Anonymous> [watching %s]", chosen_name);
-          if (resizey == 0 && resizex == 0) {
+          if (!strcmp(games[idx]->extra_info, "lisp")) {
               int fd = open(ttyrecname, O_RDONLY);
               char buf[4096];
               for (;;) {
@@ -1547,7 +1551,19 @@ watchgame:
                       }
                   }
                   if (FD_ISSET(0, &rfds)) {
-                      if (dgl_getch() == EOF) break;
+                      switch (dgl_getch()) {
+                      case EOF:
+                      case 'q':
+                          break;
+                      case 'm':
+                          if (!loggedin)
+                              loginprompt(1);
+                          if (loggedin)
+                              domailuser(chosen_name);
+                      default:
+                          continue;
+                      }
+                      break;
                   }
               }
               close(fd);
@@ -1644,7 +1660,7 @@ leavewatchgame:
 #endif
 }
 
-static void
+void
 inprogressdisplay (int gameid)
 {
     const char *selectorchars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPRSTUVWXYZ";
